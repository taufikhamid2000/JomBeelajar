# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-only fallback for NEXT_PUBLIC_SUPABASE_URL (src/lib/supabase.ts) —
# used when the admin/service client is created in a context without the
# NEXT_PUBLIC_ var available. Not required if NEXT_PUBLIC_SUPABASE_URL is set.
SUPABASE_URL=

# Server-only — never prefix with NEXT_PUBLIC_, never expose to the client.
# Powers privileged/admin Supabase calls (src/lib/supabase.ts and various
# API routes/scripts).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for scripts/apply-migrations.mjs only
# (format: postgres://user:password@host:port/database). Not used by the app itself.
SUPABASE_DB_URL=

# JomBeelajar API API
JOMBEELAJAR_API_URL=https://jombeelajar-api.taufikhamid.com

# E2E smoke tests only (npm run test:e2e). Use the shared e2e account that
# the other Jom apps use; authenticated specs skip when these are unset.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
