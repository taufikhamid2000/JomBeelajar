{
  "name": "jombeelajar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev --turbo",
    "build": "next build",
    "build:analyze": "set ANALYZE=true && next build",
    "build:optimize": "bash scripts/add-dynamic-config.sh && next build",
    "build:segment-config": "bash scripts/setup-segment-configs.sh && next build",
    "build:optimized": "NODE_ENV=production bash scripts/improved-segment-configs.sh && next build",
    "start": "next start",
    "lint": "eslint . --fix",
    "prebuild": "echo 'Type-check and lint run during next build'",
    "predeploy": "npm run lint && npm run prebuild && next build",
    "db:migrate": "node scripts/apply-migration.mjs",
    "db:migrate:admin": "node scripts/apply-migration.mjs admin-migration.sql",
    "db:test": "node scripts/test_quiz_attempts_table.mjs",
    "migrate:app-router": "node scripts/migrate-to-app-router.mjs",
    "test": "npx jest --config config/jest.config.mjs",
    "test:watch": "npx jest --config config/jest.config.mjs --watch",
    "test:coverage": "npx jest --config config/jest.config.mjs --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.1",
    "lucide-react": "^1.48.0",
    "next": "15.5.19",
    "pg": "^8.23.0",
    "postcss-cli": "^11.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^30.5.2",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "supabase": "^2.118.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6",
    "whatwg-fetch": "^3.6.20"
  }
}
